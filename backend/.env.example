# адрес http сервера
LUNAX_ADDR=:8080
LUNAX_DATABASE_URL=postgres://lunax:lunax@localhost:5432/lunax?sslmode=disable

# шифрует токены приваток в бд, не меняйте после запуска
LUNAX_SECRET_KEY=поменяйте-на-длинную-случайную-строку

# токен владельца для /api/admin/*
LUNAX_ADMIN_TOKEN=

# true — новые приватки сразу на витрине, false — после одобрения
LUNAX_AUTO_APPROVE=false

# сколько GRAM дарим новому юзеру, 0 — нисколько
LUNAX_WELCOME_BONUS=0

# если фронт на другом домене
LUNAX_CORS_ORIGIN=

# папка с собранным фронтом, бэкенд отдаст его сам
LUNAX_STATIC_DIR=../dist

# приватки владельца, см. CONNECT.md
LUNAX_SERVERS_FILE=
